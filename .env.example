# Copie este archivo como .env y complete los valores.
# .env esta en .gitignore: la llave no se sube al repositorio.

DJANGO_SECRET_KEY=cambie-esta-llave-en-produccion
DJANGO_DEBUG=1

# oilpriceapi.com  -> https://www.oilpriceapi.com
OILPRICE_API_KEY=su-llave-aqui
OILPRICE_API_BASE=https://api.oilpriceapi.com/v1

# Marcador por defecto para el analisis economico: BRENT_CRUDE_USD | WTI_USD
OILPRICE_DEFAULT_CODE=BRENT_CRUDE_USD
